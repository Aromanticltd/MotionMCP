# Motion MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# Required: Your Motion API key
# Get this from: https://app.usemotion.com/settings/api
MOTION_API_KEY=your_motion_api_key_here

# Optional: Tool configuration
# Options: minimal, essential, all, custom:tool1,tool2,...
# Default: essential
MOTION_MCP_TOOLS=essential

# Optional: Node environment
NODE_ENV=production

# Optional: Custom port (default: 8787)
PORT=8787

# Optional: Log level
LOG_LEVEL=info
